<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add a card — Stampede</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #16241d;
      --ink-soft: #1d2f26;
      --ink-softer: #24352c;
      --card: #f1e9d8;
      --card-dim: #e4d9c1;
      --brass: #c9a24b;
      --brass-bright: #e0bc6a;
      --sage: #7c9c82;
      --line: rgba(241, 233, 216, 0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--ink);
      color: var(--card);
      font-family: 'Work Sans', sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }

    h1, h2 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .wrap { max-width: 720px; margin: 0 auto; padding: 0 32px; }

    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(22, 36, 29, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    nav.wrap {
      max-width: 1100px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
    }

    .logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 700; }
    .logo .mark {
      width: 30px; height: 30px; border-radius: 50%;
      border: 1.5px dashed var(--brass);
      display: flex; align-items: center; justify-content: center;
      font-family: 'IBM Plex Mono', monospace; font-size: 0.7rem; color: var(--brass-bright);
    }

    .back-link { font-size: 0.88rem; color: var(--card-dim); display: flex; align-items: center; gap: 6px; }
    .back-link:hover { color: var(--brass-bright); }

    main { padding: 48px 0 80px; }

    .page-head { margin-bottom: 28px; }
    .page-head h1 { font-size: 1.8rem; margin-bottom: 8px; }
    .page-head p { color: var(--card-dim); font-size: 0.95rem; }

    .search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 28px;
      transition: border-color 0.15s ease;
    }
    .search-box:focus-within { border-color: var(--brass); }
    .search-box .ico { color: var(--card-dim); font-size: 1rem; }
    .search-box input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--card);
      font-family: 'Work Sans', sans-serif;
      font-size: 1rem;
    }
    .search-box input::placeholder { color: rgba(228,217,193,0.4); }

    .results { display: flex; flex-direction: column; gap: 12px; min-height: 120px; }

    .result-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px 20px;
      transition: border-color 0.15s ease;
    }
    .result-card:hover { border-color: var(--line); background: var(--ink-softer); }

    .result-info { display: flex; align-items: center; gap: 14px; min-width: 0; }

    .result-avatar {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: var(--ink-softer);
      border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--brass-bright);
      flex-shrink: 0;
    }

    .result-text { min-width: 0; }
    .result-name { font-weight: 600; font-size: 0.98rem; }
    .result-meta { font-size: 0.82rem; color: var(--card-dim); margin-top: 2px; }

    .btn-join {
      flex-shrink: 0;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 9px 18px;
      border-radius: 999px;
      background: var(--brass);
      color: var(--ink);
      border: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .btn-join:hover { background: var(--brass-bright); transform: translateY(-1px); }
    .btn-join:disabled { background: var(--ink-softer); color: var(--card-dim); cursor: default; transform: none; }

    .empty-state {
      text-align: center;
      color: var(--card-dim);
      font-size: 0.9rem;
      padding: 40px 20px;
    }

    @media (max-width: 560px) {
      .wrap { padding: 0 20px; }
      nav.wrap { padding: 0 20px; }
      .result-card { flex-direction: column; align-items: flex-start; }
      .btn-join { width: 100%; }
    }

    a:focus-visible, button:focus-visible, input:focus-visible {
      outline: 2px solid var(--brass-bright);
      outline-offset: 2px;
    }
  </style>
</head>
<body>

  <header>
    <nav class="wrap">
      <a href="/" class="logo">
        <span class="mark">St</span>
        Stampede
      </a>
      <a href="/userDashboard" class="back-link">← Back to my cards</a>
    </nav>
  </header>

  <main class="wrap">
    <div class="page-head">
      <h1>Find a business</h1>
      <p>Search for a shop to join their loyalty program and add a card to your wallet.</p>
    </div>

    <div class="search-box">
      <span class="ico">⌕</span>
      <input type="text" id="searchInput" placeholder="Search by business name..." autocomplete="off">
    </div>

    <div class="results" id="results">
      <div class="empty-state">Start typing to find a business.</div>
    </div>
  </main>

  <script>
    const input = document.getElementById('searchInput');
    const results = document.getElementById('results');
    let debounceTimer;

    async function runSearch(query) {
      results.innerHTML = '<div class="empty-state">Searching…</div>';
      try {
        const res = await fetch('http://localhost:8000/user/businesses?search=' + encodeURIComponent(query));
        const data = await res.json();
        console.log(data);
        renderResults(data.businesses || []);
      } catch (err) {
        results.innerHTML = '<div class="empty-state">Something went wrong. Try again.</div>';
      }
    }

    function renderResults(businesses) {
      if (businesses.length === 0) {
        results.innerHTML = '<div class="empty-state">No businesses found.</div>';
        return;
      }

      results.innerHTML = businesses.map((b) => {
        const initials = (b.businessName || '?').slice(0, 2).toUpperCase();
        const city = b.address && b.address.city ? b.address.city : '';
        const category = b.category || '';
        const meta = [category, city].filter(Boolean).join(' · ');

        return `
          <div class="result-card">
            <div class="result-info">
              <div class="result-avatar">${initials}</div>
              <div class="result-text">
                <div class="result-name">${b.businessName}</div>
                <div class="result-meta">${meta}</div>
              </div>
            </div>
            <button class="btn-join" data-id="${b._id}">Join</button>
          </div>
        `;
      }).join('');
    }

    // load an initial (unfiltered) list on page load
    runSearch('');

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = input.value;
      debounceTimer = setTimeout(() => runSearch(query), 300);
    });

    results.addEventListener('click', async (e) => {
    const btn = e.target.closest('.btn-join');
    if (!btn) return;

    const businessId = btn.dataset.id;

    btn.disabled = true;
    btn.textContent = 'Joining…';

    try {
        const res = await fetch('/user/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            credentials: 'include',
            body: JSON.stringify({
                businessId: businessId
            })
        });

        if (!res.ok) {
            throw new Error('Join failed');
        }

        btn.textContent = 'Joined ✓';

    } catch (err) {
        console.error(err);

        btn.disabled = false;
        btn.textContent = 'Join';
    }
});
  </script>

</body>
</html>
