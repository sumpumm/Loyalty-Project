<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Wallet — Stampede</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #16241d;
      --ink-soft: #1d2f26;
      --ink-softer: #24352c;
      --card: #f1e9d8;
      --card-dim: #e4d9c1;
      --brass: #c9a24b;
      --brass-bright: #e0bc6a;
      --sage: #7c9c82;
      --coral: #d97757;
      --line: rgba(241, 233, 216, 0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--ink);
      color: var(--card);
      font-family: 'Work Sans', sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }

    h1, h2, h3 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 32px;
    }

    /* ---------- TOPBAR ---------- */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(22, 36, 29, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }

    nav.wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Fraunces', serif;
      font-size: 1.2rem;
      font-weight: 700;
    }

    .logo .mark {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1.5px dashed var(--brass);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      color: var(--brass-bright);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 0.9rem;
      color: var(--card-dim);
    }
    .nav-links a { padding-bottom: 4px; border-bottom: 2px solid transparent; transition: color 0.15s ease, border-color 0.15s ease; }
    .nav-links a:hover { color: var(--card); }
    .nav-links a.active { color: var(--brass-bright); border-color: var(--brass); }

    .nav-actions { display: flex; align-items: center; gap: 14px; }

    .avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--brass);
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 0.9rem;
    }

    /* ---------- MAIN ---------- */
    main { padding: 44px 0 70px; }

    .page-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 34px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .page-head h1 { font-size: 1.9rem; margin-bottom: 6px; }
    .page-head .sub { color: var(--card-dim); font-size: 0.95rem; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      padding: 11px 20px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--card);
      transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }
    .btn:hover { transform: translateY(-1px); border-color: var(--brass); color: var(--brass-bright); }

    /* ---------- STATS ---------- */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 40px;
    }

    .stat-card {
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 22px;
    }

    .stat-card .label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--sage);
      margin-bottom: 12px;
      display: block;
    }

    .stat-card .value {
      font-family: 'Fraunces', serif;
      font-size: 1.9rem;
      font-weight: 700;
    }

    /* ---------- CARD GRID ---------- */
    .section-title {
      font-size: 1.2rem;
      margin-bottom: 18px;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-bottom: 48px;
    }

    .loyalty-card {
      background: var(--card);
      color: var(--ink);
      border-radius: 18px;
      padding: 24px;
      position: relative;
      box-shadow: 0 20px 40px -18px rgba(0,0,0,0.5);
      border: 1px solid rgba(22,36,29,0.06);
    }

    .loyalty-card.ready {
      background: linear-gradient(155deg, var(--brass-bright), var(--brass));
      box-shadow: 0 20px 45px -14px rgba(201,162,75,0.45);
    }

    .lc-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .lc-brand { font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.1rem; }
    .lc-category { font-size: 0.78rem; color: rgba(22,36,29,0.55); margin-top: 2px; }

    .lc-tier {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.63rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--brass-bright);
      padding: 4px 10px;
      border-radius: 999px;
    }
    .loyalty-card.ready .lc-tier { background: var(--ink); color: var(--brass-bright); }

    .lc-punches { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .lc-punch {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px dashed rgba(22,36,29,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.6rem;
    }
    .lc-punch.filled { border-style: solid; border-color: var(--ink); background: var(--ink); color: var(--brass-bright); }

    .lc-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.82rem;
    }
    .lc-progress-text { color: rgba(22,36,29,0.65); }
    .loyalty-card.ready .lc-progress-text { color: rgba(22,36,29,0.75); }

    .lc-cta {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 7px 14px;
      border-radius: 999px;
      background: var(--ink);
      color: var(--brass-bright);
    }

    /* add-card tile */
    .add-card-tile {
      border: 1.5px dashed var(--line);
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 24px;
      min-height: 180px;
      color: var(--card-dim);
      text-align: center;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .add-card-tile:hover { border-color: var(--brass); color: var(--brass-bright); }
    .add-card-tile .plus {
      width: 40px; height: 40px;
      border-radius: 50%;
      border: 1.5px dashed currentColor;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
    }

    /* ---------- ACTIVITY ---------- */
    .panel {
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 26px;
    }

    .activity-list { display: flex; flex-direction: column; gap: 18px; }
    .activity-item { display: flex; align-items: flex-start; gap: 14px; }

    .activity-icon {
      width: 34px; height: 34px;
      border-radius: 50%;
      background: var(--ink-softer);
      border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }
    .activity-icon.reward { background: rgba(201,162,75,0.16); border-color: transparent; color: var(--brass-bright); }

    .activity-item p { font-size: 0.9rem; }
    .activity-item p strong { font-weight: 600; }
    .activity-item .time { display: block; font-size: 0.78rem; color: var(--card-dim); margin-top: 2px; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 900px) {
      .card-grid { grid-template-columns: repeat(2, 1fr); }
      .stats { grid-template-columns: 1fr 1fr; }
      .nav-links { display: none; }
    }

    @media (max-width: 560px) {
      .wrap { padding: 0 20px; }
      .card-grid { grid-template-columns: 1fr; }
      .stats { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }

    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--brass-bright);
      outline-offset: 2px;
    }
  </style>
</head>
<body>

  <header>
    <nav class="wrap">
      <a href="/" class="logo">
        <span class="mark">St</span>
        Stampede
      </a>
      <div class="nav-links">
        <a href="/wallet" class="active">My cards</a>
        <a href="/wallet/activity">Activity</a>
        <a href="/wallet/discover">Discover businesses</a>
      </div>
      <div class="nav-actions">
        <a href="/account" class="avatar">MR</a>
      </div>
    </nav>
  </header>

  <main class="wrap">
    <div class="page-head">
      <div>
        <h1>Hey Maria, here's your wallet</h1>
        <div class="sub">3 loyalty cards, 1 reward ready to redeem</div>
      </div>
      <a href="/wallet/discover" class="btn">+ Add a card</a>
    </div>

    <!-- STATS -->
    <div class="stats">
      <div class="stat-card">
        <span class="label">Active cards</span>
        <div class="value">3</div>
      </div>
      <div class="stat-card">
        <span class="label">Total stamps earned</span>
        <div class="value">47</div>
      </div>
      <div class="stat-card">
        <span class="label">Rewards unlocked</span>
        <div class="value">6</div>
      </div>
    </div>

    <!-- CARDS -->
    <h2 class="section-title">Your cards</h2>
    <div class="card-grid">

      <!-- reward ready -->
      <div class="loyalty-card ready">
        <div class="lc-top">
          <div>
            <div class="lc-brand">Cedar &amp; Co.</div>
            <div class="lc-category">Coffee shop</div>
          </div>
          <div class="lc-tier">Reward ready</div>
        </div>
        <div class="lc-punches">
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
        </div>
        <div class="lc-foot">
          <span class="lc-progress-text">Free coffee unlocked</span>
          <span class="lc-cta">Redeem →</span>
        </div>
      </div>

      <!-- in progress -->
      <div class="loyalty-card">
        <div class="lc-top">
          <div>
            <div class="lc-brand">Rosemary Kitchen</div>
            <div class="lc-category">Restaurant</div>
          </div>
          <div class="lc-tier">Active</div>
        </div>
        <div class="lc-punches">
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
        </div>
        <div class="lc-foot">
          <span class="lc-progress-text">6 stamps to reward</span>
          <span class="lc-cta">View</span>
        </div>
      </div>

      <!-- in progress -->
      <div class="loyalty-card">
        <div class="lc-top">
          <div>
            <div class="lc-brand">Bloom &amp; Wick</div>
            <div class="lc-category">Florist</div>
          </div>
          <div class="lc-tier">Active</div>
        </div>
        <div class="lc-punches">
          <div class="lc-punch filled">✓</div><div class="lc-punch filled">✓</div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
          <div class="lc-punch"></div><div class="lc-punch"></div>
        </div>
        <div class="lc-foot">
          <span class="lc-progress-text">8 stamps to reward</span>
          <span class="lc-cta">View</span>
        </div>
      </div>

      <!-- add card tile -->
      <a href="/wallet/discover" class="add-card-tile">
        <div class="plus">+</div>
        <div>Join a new loyalty program</div>
      </a>
    </div>

    <!-- ACTIVITY -->
    <h2 class="section-title">Recent activity</h2>
    <div class="panel">
      <div class="activity-list">
        <div class="activity-item">
          <div class="activity-icon reward">★</div>
          <p><strong>Reward unlocked</strong> at Cedar &amp; Co. — your 10th stamp earned a free coffee.
            <span class="time">Today, 9:14 AM</span>
          </p>
        </div>
        <div class="activity-item">
          <div class="activity-icon">●</div>
          <p>Stamp added at <strong>Cedar &amp; Co.</strong>
            <span class="time">Today, 9:14 AM</span>
          </p>
        </div>
        <div class="activity-item">
          <div class="activity-icon">●</div>
          <p>Stamp added at <strong>Rosemary Kitchen</strong>
            <span class="time">Yesterday</span>
          </p>
        </div>
        <div class="activity-item">
          <div class="activity-icon">●</div>
          <p>Stamp added at <strong>Bloom &amp; Wick</strong>
            <span class="time">3 days ago</span>
          </p>
        </div>
        <div class="activity-item">
          <div class="activity-icon">◆</div>
          <p>You joined <strong>Bloom &amp; Wick</strong>'s loyalty program.
            <span class="time">2 weeks ago</span>
          </p>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
