<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Stampede</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #16241d;
      --ink-soft: #1d2f26;
      --ink-softer: #24352c;
      --card: #f1e9d8;
      --card-dim: #e4d9c1;
      --brass: #c9a24b;
      --brass-bright: #e0bc6a;
      --sage: #7c9c82;
      --coral: #d97757;
      --line: rgba(241, 233, 216, 0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--ink);
      color: var(--card);
      font-family: 'Work Sans', sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }

    h1, h2, h3 {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .app {
      display: grid;
      grid-template-columns: 250px 1fr;
      min-height: 100vh;
    }

    /* ---------- SIDEBAR ---------- */
    .sidebar {
      background: var(--ink-soft);
      border-right: 1px solid var(--line);
      padding: 26px 20px;
      display: flex;
      flex-direction: column;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Fraunces', serif;
      font-size: 1.15rem;
      font-weight: 700;
      padding: 0 8px;
      margin-bottom: 36px;
    }

    .logo .mark {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1.5px dashed var(--brass);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      color: var(--brass-bright);
    }

    .nav-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--sage);
      padding: 0 10px;
      margin-bottom: 10px;
    }

    .nav-group { margin-bottom: 28px; }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 10px 10px;
      border-radius: 10px;
      font-size: 0.92rem;
      color: var(--card-dim);
      margin-bottom: 2px;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .nav-item .ico {
      width: 18px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .nav-item:hover { background: rgba(241,233,216,0.05); color: var(--card); }

    .nav-item.active {
      background: rgba(201, 162, 75, 0.12);
      color: var(--brass-bright);
      font-weight: 500;
    }

    .sidebar-footer {
      margin-top: auto;
      border-top: 1px solid var(--line);
      padding-top: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--brass);
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .sidebar-footer .who { line-height: 1.3; overflow: hidden; }
    .sidebar-footer .who strong { font-size: 0.85rem; display: block; }
    .sidebar-footer .who span { font-size: 0.75rem; color: var(--card-dim); }

    /* ---------- MAIN ---------- */
    .main { padding: 30px 40px 60px; }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .topbar h1 { font-size: 1.6rem; }
    .topbar .sub { color: var(--card-dim); font-size: 0.9rem; margin-top: 4px; }

    .topbar-actions { display: flex; align-items: center; gap: 12px; }

    .search {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--ink-softer);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 9px 16px;
      font-size: 0.85rem;
      color: var(--card-dim);
      width: 220px;
    }
    .search input {
      background: transparent;
      border: none;
      outline: none;
      color: var(--card);
      font-family: 'Work Sans', sans-serif;
      font-size: 0.85rem;
      width: 100%;
    }
    .search input::placeholder { color: rgba(228,217,193,0.4); }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      padding: 11px 20px;
      border-radius: 999px;
      border: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-solid { background: var(--brass); color: var(--ink); }
    .btn-solid:hover { background: var(--brass-bright); }

    /* ---------- STATS ---------- */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 22px;
    }

    .stat-card .label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--sage);
      margin-bottom: 14px;
      display: block;
    }

    .stat-card .value {
      font-family: 'Fraunces', serif;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .stat-card .delta {
      font-size: 0.82rem;
      color: var(--card-dim);
    }
    .stat-card .delta.up { color: var(--sage); }
    .stat-card .delta.down { color: var(--coral); }

    /* ---------- CONTENT GRID ---------- */
    .content-grid {
      display: grid;
      grid-template-columns: 1.7fr 1fr;
      gap: 20px;
    }

    .panel {
      background: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 24px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .panel-head h2 { font-size: 1.1rem; }
    .panel-head a { font-size: 0.82rem; color: var(--brass-bright); }
    .panel-head a:hover { text-decoration: underline; }

    /* customers table */
    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--sage);
      padding: 0 0 12px;
      border-bottom: 1px solid var(--line);
      font-weight: 500;
    }

    tbody td {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.9rem;
      vertical-align: middle;
    }
    tbody tr:last-child td { border-bottom: none; }

    .cust {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .cust .avatar-sm {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--ink-softer);
      color: var(--card);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fraunces', serif;
      font-weight: 700;
      font-size: 0.75rem;
      flex-shrink: 0;
      border: 1px solid var(--line);
    }
    .cust .name { font-weight: 500; }
    .cust .email { display: block; font-size: 0.78rem; color: var(--card-dim); }

    .mini-punches { display: flex; gap: 4px; }
    .mini-punch {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      border: 1.3px dashed rgba(228,217,193,0.3);
    }
    .mini-punch.filled { background: var(--brass); border: none; }

    .status-pill {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 500;
      padding: 4px 11px;
      border-radius: 999px;
    }
    .status-pill.active { background: rgba(124,156,130,0.16); color: var(--sage); }
    .status-pill.reward { background: rgba(201,162,75,0.16); color: var(--brass-bright); }
    .status-pill.quiet { background: rgba(217,119,87,0.14); color: var(--coral); }

    .row-action {
      font-size: 0.8rem;
      color: var(--card-dim);
      border: 1px solid var(--line);
      background: transparent;
      padding: 6px 12px;
      border-radius: 999px;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .row-action:hover { border-color: var(--brass); color: var(--brass-bright); }

    /* activity feed */
    .activity-list { display: flex; flex-direction: column; gap: 18px; }
    .activity-item { display: flex; gap: 12px; }
    .activity-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--brass); margin-top: 6px; flex-shrink: 0;
    }
    .activity-item p { font-size: 0.87rem; }
    .activity-item p strong { font-weight: 600; }
    .activity-item .time {
      display: block;
      font-size: 0.76rem;
      color: var(--card-dim);
      margin-top: 2px;
    }

    /* weekly bar chart */
    .chart-panel { margin-top: 20px; }
    .bars {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      height: 110px;
      margin-bottom: 10px;
    }
    .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
    .bar {
      width: 100%;
      border-radius: 6px 6px 2px 2px;
      background: var(--ink-softer);
      border: 1px solid var(--line);
      position: relative;
    }
    .bar.today { background: var(--brass); border: none; }
    .bar-labels { display: flex; gap: 10px; }
    .bar-labels span {
      flex: 1;
      text-align: center;
      font-size: 0.7rem;
      color: var(--card-dim);
      font-family: 'IBM Plex Mono', monospace;
    }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 1100px) {
      .content-grid { grid-template-columns: 1fr; }
      .stats { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 820px) {
      .app { grid-template-columns: 1fr; }
      .sidebar {
        flex-direction: row;
        align-items: center;
        overflow-x: auto;
        padding: 14px 16px;
      }
      .logo { margin-bottom: 0; }
      .nav-group { display: flex; gap: 4px; margin-bottom: 0; }
      .nav-label { display: none; }
      .sidebar-footer { display: none; }
      .main { padding: 24px 20px 50px; }
      .search { display: none; }
      .stats { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 480px) {
      .stats { grid-template-columns: 1fr; }
      table thead { display: none; }
      tbody td { display: block; border-bottom: none; padding: 4px 0; }
      tbody tr { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }

    a:focus-visible, button:focus-visible, input:focus-visible {
      outline: 2px solid var(--brass-bright);
      outline-offset: 2px;
    }
  </style>
</head>
<body>

  <div class="app">
    <!-- ---------- SIDEBAR ---------- -->
    <aside class="sidebar">
      <a href="/" class="logo">
        <span class="mark">St</span>
        Stampede
      </a>

      <div class="nav-group">
        <div class="nav-label">Main</div>
        <a href="/dashboard" class="nav-item active"><span class="ico">◆</span> Overview</a>
        <a href="/customers" class="nav-item"><span class="ico">☺</span> Customers</a>
        <a href="/cards" class="nav-item"><span class="ico">▤</span> Loyalty cards</a>
        <a href="/rewards" class="nav-item"><span class="ico">★</span> Rewards</a>
      </div>

      <div class="nav-group">
        <div class="nav-label">Manage</div>
        <a href="/analytics" class="nav-item"><span class="ico">▲</span> Analytics</a>
        <a href="/settings" class="nav-item"><span class="ico">⚙</span> Settings</a>
      </div>

      <div class="sidebar-footer">
        <div class="avatar">CC</div>
        <div class="who">
          <strong>Cedar &amp; Co.</strong>
          <span>owner@cedarco.com</span>
        </div>
      </div>
    </aside>

    <!-- ---------- MAIN ---------- -->
    <main class="main">
      <div class="topbar">
        <div>
          <h1>Good morning, <%= email %>.</h1>
          <div class="sub">Here's how your loyalty program is doing today.</div>
        </div>
        <div class="topbar-actions">
          <div class="search">
            <span>⌕</span>
            <input type="text" placeholder="Search customers...">
          </div>
          <button class="btn btn-solid">+ Add stamp</button>
        </div>
      </div>

      <!-- STATS -->
      <div class="stats">
        <div class="stat-card">
          <span class="label">Total customers</span>
          <div class="value">1,284</div>
          <div class="delta up">↑ 8.2% this month</div>
        </div>
        <div class="stat-card">
          <span class="label">Active cards</span>
          <div class="value">942</div>
          <div class="delta up">↑ 4.6% this month</div>
        </div>
        <div class="stat-card">
          <span class="label">Rewards redeemed</span>
          <div class="value">176</div>
          <div class="delta up">↑ 12 this week</div>
        </div>
        <div class="stat-card">
          <span class="label">Stamps this week</span>
          <div class="value">513</div>
          <div class="delta down">↓ 3.1% vs last week</div>
        </div>
      </div>

      <!-- CONTENT -->
      <div class="content-grid">
        <!-- CUSTOMERS TABLE -->
        <div class="panel">
          <div class="panel-head">
            <h2>Recent customers</h2>
            <a href="/customers">View all →</a>
          </div>
          <table>
            <thead>
              <tr>
                <th>Customer</th>
                <th>Progress</th>
                <th>Last visit</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="cust">
                    <div class="avatar-sm">MR</div>
                    <div>
                      <span class="name">Maria Reyes</span>
                      <span class="email">maria.reyes@gmail.com</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mini-punches">
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch filled"></div><div class="mini-punch"></div>
                  </div>
                </td>
                <td>2 hours ago</td>
                <td><span class="status-pill reward">1 stamp to reward</span></td>
                <td><button class="row-action">Add stamp</button></td>
              </tr>
              <tr>
                <td>
                  <div class="cust">
                    <div class="avatar-sm">JK</div>
                    <div>
                      <span class="name">Jordan Kim</span>
                      <span class="email">jordan.kim@outlook.com</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mini-punches">
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch"></div><div class="mini-punch"></div>
                    <div class="mini-punch"></div><div class="mini-punch"></div>
                  </div>
                </td>
                <td>Yesterday</td>
                <td><span class="status-pill active">Active</span></td>
                <td><button class="row-action">Add stamp</button></td>
              </tr>
              <tr>
                <td>
                  <div class="cust">
                    <div class="avatar-sm">AT</div>
                    <div>
                      <span class="name">Aisha Thompson</span>
                      <span class="email">aisha.t@yahoo.com</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mini-punches">
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch filled"></div><div class="mini-punch"></div>
                    <div class="mini-punch"></div><div class="mini-punch"></div>
                  </div>
                </td>
                <td>3 days ago</td>
                <td><span class="status-pill active">Active</span></td>
                <td><button class="row-action">Add stamp</button></td>
              </tr>
              <tr>
                <td>
                  <div class="cust">
                    <div class="avatar-sm">DP</div>
                    <div>
                      <span class="name">Daniel Park</span>
                      <span class="email">d.park@icloud.com</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mini-punches">
                    <div class="mini-punch filled"></div><div class="mini-punch"></div>
                    <div class="mini-punch"></div><div class="mini-punch"></div>
                    <div class="mini-punch"></div><div class="mini-punch"></div>
                  </div>
                </td>
                <td>18 days ago</td>
                <td><span class="status-pill quiet">Gone quiet</span></td>
                <td><button class="row-action">Add stamp</button></td>
              </tr>
              <tr>
                <td>
                  <div class="cust">
                    <div class="avatar-sm">SL</div>
                    <div>
                      <span class="name">Sofia Lindqvist</span>
                      <span class="email">sofia.l@proton.me</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mini-punches">
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                    <div class="mini-punch filled"></div><div class="mini-punch filled"></div>
                  </div>
                </td>
                <td>Today</td>
                <td><span class="status-pill reward">Reward ready</span></td>
                <td><button class="row-action">Redeem</button></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- SIDE COLUMN -->
        <div>
          <div class="panel">
            <div class="panel-head">
              <h2>Recent activity</h2>
            </div>
            <div class="activity-list">
              <div class="activity-item">
                <div class="activity-dot"></div>
                <p><strong>Sofia Lindqvist</strong> filled her card and unlocked a reward.
                  <span class="time">12 minutes ago</span>
                </p>
              </div>
              <div class="activity-item">
                <div class="activity-dot"></div>
                <p><strong>Maria Reyes</strong> received a stamp at checkout.
                  <span class="time">2 hours ago</span>
                </p>
              </div>
              <div class="activity-item">
                <div class="activity-dot"></div>
                <p><strong>New customer</strong> Priya Nair joined via QR code.
                  <span class="time">5 hours ago</span>
                </p>
              </div>
              <div class="activity-item">
                <div class="activity-dot"></div>
                <p><strong>Jordan Kim</strong> received a stamp at checkout.
                  <span class="time">Yesterday</span>
                </p>
              </div>
            </div>
          </div>

          <div class="panel chart-panel">
            <div class="panel-head">
              <h2>Stamps this week</h2>
            </div>
            <div class="bars">
              <div class="bar-col"><div class="bar" style="height: 40%;"></div></div>
              <div class="bar-col"><div class="bar" style="height: 65%;"></div></div>
              <div class="bar-col"><div class="bar" style="height: 50%;"></div></div>
              <div class="bar-col"><div class="bar" style="height: 78%;"></div></div>
              <div class="bar-col"><div class="bar" style="height: 58%;"></div></div>
              <div class="bar-col"><div class="bar" style="height: 90%;"></div></div>
              <div class="bar-col"><div class="bar today" style="height: 70%;"></div></div>
            </div>
            <div class="bar-labels">
              <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

</body>
</html>
